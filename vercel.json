{
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'"
        }
      ],
      "source": "/(.*)"
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/theme-purple.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/about.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/age.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hero.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/livebg.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/reels/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/spark-bot.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "destination": "/events",
      "permanent": false,
      "source": "/registration"
    },
    {
      "destination": "/events",
      "permanent": false,
      "source": "/registration/"
    },
    {
      "destination": "/registration/quiz",
      "permanent": false,
      "source": "/register-quiz.html"
    },
    {
      "destination": "/registration/treasure-hunt",
      "permanent": false,
      "source": "/register-treasure-hunt.html"
    },
    {
      "destination": "/registration/prompting",
      "permanent": false,
      "source": "/register-prompting.html"
    },
    {
      "destination": "/registration/idea-presentation",
      "permanent": false,
      "source": "/register-idea-presentation.html"
    },
    {
      "destination": "/registration/reels-competition",
      "permanent": false,
      "source": "/register-reels-competition.html"
    }
  ],
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/about"
    },
    {
      "destination": "/events.html",
      "source": "/events"
    },
    {
      "destination": "/map.html",
      "source": "/maps"
    },
    {
      "destination": "/contact.html",
      "source": "/contact"
    },
    {
      "destination": "/gallery.html",
      "source": "/gallery"
    },
    {
      "destination": "/register.html?event=:event",
      "source": "/registration/:event"
    },
    {
      "destination": "/admin.html",
      "source": "/admin"
    }
  ],
  "trailingSlash": false
}